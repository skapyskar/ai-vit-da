{
  "name": "eight-puzzle-dls-lab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Depth Limited Search 8-puzzle visualizer for 24BCT0058",
  "scripts": {
    "build": "node scripts/build.mjs",
    "format:check": "prettier --check index.html css/styles.css js tests scripts playwright.config.js package.json '.github/workflows/*.yml'",
    "start": "python3 -m http.server 8080 --bind 127.0.0.1",
    "test": "node --test --test-isolation=none tests/*.test.js",
    "test:coverage": "node --experimental-test-coverage --test-coverage-include='js/puzzle.js' --test-coverage-include='js/dls.js' --test-coverage-lines=80 --test-coverage-functions=80 --test-coverage-branches=80 --test --test-isolation=none tests/*.test.js",
    "test:e2e": "playwright test",
    "check": "node --check js/puzzle.js && node --check js/dls.js && node --check js/app.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@playwright/test": "1.58.2",
    "prettier": "3.6.2"
  }
}
